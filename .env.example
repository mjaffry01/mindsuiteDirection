# MindSuite settings. Copy this file to ".env" (same folder), fill in your
# values, and restart the app. Never share or commit the .env file.

# --- AI: company OpenRouter key (optional if every rep adds their own under My AI) ---
# Used by reps without their own key, and by automatic lead engine runs.
# Create a key at https://openrouter.ai under Keys. It starts with sk-or-
OPENROUTER_API_KEY=
# The model ID exactly as shown on https://openrouter.ai/models
# (provider/model-name). openrouter/auto lets OpenRouter choose.
OPENROUTER_MODEL=openrouter/auto
# Optional: a different model just for the lead engine's web searches.
ENGINE_WEB_MODEL=

# --- Optional extra search source for the lead engine ---
BRAVE_SEARCH_API_KEY=

# --- Server ---
PORT=3000
# Your public address once deployed, e.g. https://app.mindsuite.in
APP_URL=

# --- Sign-in: one account per rep (needed for each rep's own AI settings) ---
# Name:password pairs, comma-separated. Example: Ravi:LongPassword1,Sara:LongPassword2
APP_USERS=
# Optional single extra account
APP_USER=
APP_PASSWORD=

# --- Reps' own OpenRouter keys (My AI tab) ---
# Long random text used to encrypt reps' keys. If empty, one is created in
# data/.secret-key. Keep it safe: if it changes, reps must re-enter their keys.
SECRET_KEY=
# Set to 0 to stop reps adding their own keys (company key only).
AI_ALLOW_USER_KEYS=1

# --- Lead capture (see README) ---
LEAD_API_KEYS=
LEAD_FORM_ORIGINS=
LEAD_NOTIFY_WEBHOOK=
